{
  "name": "panahgozar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-protocol VPN & proxy management panel - configuration-first architecture",
  "license": "MIT",
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "node scripts/clean.mjs && pnpm typecheck:web && pnpm build:web && pnpm build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "release": "pnpm db:migrate && pnpm db:seed",
    "start:deploy": "pnpm release && pnpm start",
    "typecheck": "pnpm typecheck:server && pnpm typecheck:web && pnpm typecheck:test",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "lint": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.{mjs,ts}\" \"prisma/**/*.ts\" \"*.{json,ts,js}\"",
    "lint:fix": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.{mjs,ts}\" \"prisma/**/*.ts\" \"*.{json,ts,js}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "ops:create-admin": "tsx scripts/create-admin.ts",
    "ops:validate-manifests": "node scripts/validate-manifests.mjs",
    "setup": "pnpm db:migrate && pnpm db:seed && pnpm db:generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^5.19.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.7",
    "pino": "^9.3.2",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.13",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.41",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^1.6.0",
    "yaml": "^2.5.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
