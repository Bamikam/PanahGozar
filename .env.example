# ============================================================================
# PanahGozar - environment configuration
# ============================================================================
# Copy to `.env` for local development. NEVER commit a real `.env`.
# On Railway/Render set variables in the platform's variable manager.
# Every secret below is intentionally empty/example-only. Generate your own.
# ============================================================================

# ------------------------------------------------------------------ runtime -
# development | test | production
NODE_ENV=development

# Platform-assigned port. The server binds 0.0.0.0 on this port.
# Railway and Render provide PORT automatically; do not rename it.
PORT=3000

# Exact public origin used in subscription links and exported artifacts.
# No trailing slash. On Render, RENDER_EXTERNAL_URL is used automatically when
# this is omitted. On Railway, RAILWAY_PUBLIC_DOMAIN is used automatically.
# Set this explicitly when a custom domain is used.
PUBLIC_URL=http://127.0.0.1:5173

# ----------------------------------------------------------------- database -
# PostgreSQL connection string. Railway/Render managed PostgreSQL is supported.
# Prefer the platform-internal URL. SSL options such as ?sslmode=require can be
# appended when required by the provider.
DATABASE_URL=postgresql://panahgozar:panahgozar@localhost:5432/panahgozar?schema=public

# ------------------------------------------------------------------ secrets -
# At least 32 random characters. Generate with: openssl rand -base64 48
# Never reuse across environments. Changing it logs every user out.
SESSION_SECRET=

# Exactly 32 bytes, encoded as 64 hex characters OR base64 (Render generateValue).
# Generate with: openssl rand -hex 32
# Rotating this key makes existing sealed credentials unreadable.
ENCRYPTION_KEY=

# One-time first-administrator provisioning. Empty disables HTTP setup.
# At least 16 random characters. Used only while no administrator exists.
# Generate with: openssl rand -base64 24
SETUP_TOKEN=

# ------------------------------------------------------------------ logging -
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ---------------------------------------------------- runtime capabilities --
# There is no in-process protocol listener implementation in this repository.
# Keep false. Diagnostics reports the truth; this switch does not grant raw
# TCP/UDP ingress, kernel access, or a VPN binary.
ENABLE_RUNTIME_LISTENERS=false

# Behind the Railway/Render reverse proxy, keep true so client IPs are parsed
# from the trusted forwarding headers for logging/rate limiting.
TRUST_PROXY=true

# auto | true | false. "auto" sets Secure cookies when PUBLIC_URL is https.
COOKIE_SECURE=auto

# ------------------------------------------------------------- release hooks -
# Optional last-resort Docker startup hooks. Prefer a pre-deploy/release phase.
# The Dockerfile enables these for single-replica Docker deployments.
RUN_MIGRATIONS_ON_START=0
RUN_SEED_ON_START=0

# -------------------------------------------------------------- keep-alive -
# Optional best-effort idle prevention. When enabled, the app requests its own
# public /api/health endpoint every N minutes, producing inbound edge traffic
# that counters common free/Serverless idle spin-down. It is not an uptime
# guarantee and cannot wake an already stopped process. Keep 3 minutes to stay
# below typical Serverless thresholds. Enabled in the Dockerfile/Render configs.
KEEP_ALIVE_ENABLED=false
KEEP_ALIVE_INTERVAL_MINUTES=3
